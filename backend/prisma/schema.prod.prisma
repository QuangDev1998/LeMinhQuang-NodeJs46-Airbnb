// Schema RIÊNG cho deploy trên Render -> dùng Postgres managed (Neon) để DATA
// TỒN TẠI VĨNH VIỄN, không reset khi BE restart. Local/dev vẫn dùng schema.prisma
// (MySQL). Models giữ giống hệt; kiểu cơ bản (String/Int/Boolean/DateTime) map
// thẳng sang Postgres nên không cần native type.
//
// DATABASE_URL = connection string Neon (direct, không -pooler), đặt trong
// Render dashboard. VD: postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NguoiDung {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  pass_word String
  phone     String
  birth_day DateTime?
  gender    Boolean
  role      String
  avatar    String?
  BinhLuan  BinhLuan[]
  DatPhong  DatPhong[]
  YeuThich  YeuThich[]
}

model ViTri {
  id         Int     @id @default(autoincrement())
  ten_vi_tri String
  tinh_thanh String
  quoc_gia   String
  hinh_anh   String?
  Phong      Phong[]
}

model Phong {
  id            Int        @id @default(autoincrement())
  ten_phong     String
  khach         Int
  phong_ngu     Int
  giuong        Int
  phong_tam     Int
  mo_ta         String
  gia_tien      Int
  may_giat      Boolean
  ban_la        Boolean
  tivi          Boolean
  dieu_hoa      Boolean
  wifi          Boolean
  bep           Boolean
  do_xe         Boolean
  ho_boi        Boolean
  ban_ui        Boolean
  hinh_anh      String
  loai_phong    String     @default("Phòng")
  danh_sach_anh String?
  vi_tri_id     Int
  BinhLuan      BinhLuan[]
  DatPhong      DatPhong[]
  YeuThich      YeuThich[]
  ViTri         ViTri      @relation(fields: [vi_tri_id], references: [id])

  @@index([vi_tri_id])
}

model YeuThich {
  id            Int       @id @default(autoincrement())
  ma_nguoi_dung Int
  ma_phong      Int
  ngay_tao      DateTime  @default(now())
  NguoiDung     NguoiDung @relation(fields: [ma_nguoi_dung], references: [id])
  Phong         Phong     @relation(fields: [ma_phong], references: [id])

  @@unique([ma_nguoi_dung, ma_phong])
  @@index([ma_nguoi_dung])
  @@index([ma_phong])
}

model DatPhong {
  id             Int       @id @default(autoincrement())
  ma_phong       Int
  ngay_den       DateTime
  ngay_di        DateTime
  so_luong_khach Int
  ma_nguoi_dat   Int
  NguoiDung      NguoiDung @relation(fields: [ma_nguoi_dat], references: [id])
  Phong          Phong     @relation(fields: [ma_phong], references: [id])

  @@index([ma_nguoi_dat])
  @@index([ma_phong])
}

model BinhLuan {
  id                 Int       @id @default(autoincrement())
  ma_phong           Int
  ma_nguoi_binh_luan Int
  ngay_binh_luan     DateTime
  noi_dung           String
  sao_binh_luan      Int
  Phong              Phong     @relation(fields: [ma_phong], references: [id])
  NguoiDung          NguoiDung @relation(fields: [ma_nguoi_binh_luan], references: [id])

  @@index([ma_phong])
  @@index([ma_nguoi_binh_luan])
}

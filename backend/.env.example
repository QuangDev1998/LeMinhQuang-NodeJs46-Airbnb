# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit .env lên git.

# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/airbnb_db"

# Server
PORT=3001
CLIENT_URL=http://localhost:3000

# JWT
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRED=1d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_string
REFRESH_TOKEN_EXPIRED=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
